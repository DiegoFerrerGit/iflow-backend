# Required – app will not start without these
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=iflow_dev
JWT_ACCESS_SECRET=your_access_secret
JWT_REFRESH_SECRET=your_refresh_secret
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
FRONTEND_ORIGIN=http://localhost:4200

# Optional – have safe defaults
# ACCESS_TOKEN_TTL_MIN=15
# REFRESH_TOKEN_TTL_DAYS=30
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax
# USD_TO_ARS_RATE_DEFAULT=1450
# API_DELAY_SECONDS=0
# ALLOWLIST_ENABLED=true
# BETA_SIGNUP_SECRET=your_signup_secret

# Optional – for mobile dev (comma-separated CORS origins)
# FRONTEND_ORIGINS=http://localhost:4200,http://192.168.1.5:4200
